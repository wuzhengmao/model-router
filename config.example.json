{
  "listen": "127.0.0.1:18080",
  "auth_token": "replace-with-your-client-token",
  "admin_user": "admin",
  "admin_password": "replace-with-your-admin-password",
  "fallback": {
    "failure_threshold": 3,
    "degrade_duration": "5m",
    "min_tokens_per_second": 30,
    "idle_timeout": "30s"
  },
  "instances": {
    "openai": [
      {
        "name": "DeepSeek",
        "base_url": "https://api.deepseek.com",
        "api_key": "sk-replace-with-your-deepseek-key",
        "provider": "deepseek",
        "timeout": "15s",
        "models": ["deepseek-chat", "deepseek-reasoner"],
        "model_capabilities": {
          "deepseek-chat": {
            "max_input_tokens": 1000000,
            "max_tokens": 128000,
            "image_input": true
          },
          "deepseek-reasoner": {
            "max_input_tokens": 1000000,
            "max_tokens": 128000,
            "thinking": true
          }
        }
      }
    ],
    "anthropic": [
      {
        "name": "DeepSeek-Anthropic",
        "base_url": "https://api.deepseek.com/anthropic",
        "api_key": "sk-replace-with-your-deepseek-key",
        "provider": "deepseek",
        "timeout": "15s",
        "roles": {
          "sonnet": "deepseek-v4-flash",
          "opus": "deepseek-v4-pro",
          "fable": "deepseek-v4-pro",
          "haiku": "deepseek-v4-flash"
        },
        "role_names": {
          "sonnet": "claude-sonnet-5",
          "opus": "claude-opus-5",
          "fable": "claude-fable-5",
          "haiku": "claude-haiku-4-5"
        },
        "model_capabilities": {
          "deepseek-v4-flash": {
            "max_input_tokens": 1000000,
            "max_tokens": 128000,
            "image_input": true,
            "thinking": true
          },
          "deepseek-v4-pro": {
            "max_input_tokens": 1000000,
            "max_tokens": 128000,
            "image_input": true,
            "thinking": true,
            "structured_outputs": true
          }
        }
      },
      {
        "name": "DeepSeek-Tail",
        "base_url": "https://api.deepseek.com/anthropic",
        "api_key": "sk-replace-with-your-deepseek-key",
        "provider": "deepseek",
        "timeout": "15s",
        "roles": {
          "*": "deepseek-chat"
        }
      }
    ]
  }
}
